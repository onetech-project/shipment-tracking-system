# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@postgres:5432/app

# ── JWT ───────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_64_bytes_hex
JWT_REFRESH_SECRET=change_me_refresh_secret_64_bytes_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Account Security ──────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
SESSION_INACTIVITY_MINUTES=30

# ── Invitations ───────────────────────────────────────────
INVITATION_EXPIRY_HOURS=72

# ── Email (SMTP) ──────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shipment-tracking.local

# ── Redis (BullMQ) ────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── App ───────────────────────────────────────────────────
APP_URL=http://localhost:3000
BACKEND_PORT=4000
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Shipment Import ───────────────────────────────────────
SHIPMENT_IMPORT_MAX_FILE_MB=10
SHIPMENT_IMPORT_CONCURRENCY=3
SHIPMENT_ID_REGEX=^[A-Z0-9-]{6,40}$

# Google Sheets integration
GOOGLE_CREDENTIALS_PATH=/absolute/path/to/config/serviceaccount.json

# WebSocket CORS (set to your frontend origin)
WEBSOCKET_CORS_ORIGIN=http://localhost:3000

# ── Object storage (MinIO / S3) ───────────────────────────
# S3_PUBLIC_ENDPOINT is what the BROWSER reaches; S3_ENDPOINT is what the backend reaches.
# BOTH are required in any deployment where the two differ. The backend opens a separate client
# per endpoint: presigned URLs are signed for the public host, while HeadObject/DeleteObject are
# sent to S3_ENDPOINT. Setting only the public one makes every upload confirm fail with
# ENOTFOUND once that hostname is not resolvable from inside the container.
# A presigned URL must be signed for the host the browser will use, or MinIO answers
# SignatureDoesNotMatch.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=esp-fleet
S3_FORCE_PATH_STYLE=true